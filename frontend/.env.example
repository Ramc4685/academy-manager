BFF_API_ORIGIN=http://127.0.0.1:8001
NEXT_PUBLIC_API_BASE=/api/v2

# Firebase Web config is public client configuration, not a service-account secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=academy-courtmastr.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=academy-courtmastr
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=academy-courtmastr.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=953230788846
NEXT_PUBLIC_FIREBASE_APP_ID=1:953230788846:web:1f2819c11418ecf5860bff
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-Z6GS6WRZY8

# Browser error capture (optional). Leave unset to disable: the Sentry SDK is
# not even loaded without a DSN. The Sentry project `courtmastr-frontend` exists;
# its public DSN is the GitHub repo variable NEXT_PUBLIC_SENTRY_DSN (Settings ->
# Projects -> courtmastr-frontend -> Client Keys).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_SENTRY_RELEASE=

# Local-only optional flags.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_W1B_OFFLINE_WRITES=1
