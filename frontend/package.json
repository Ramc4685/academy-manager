{
  "name": "academy-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-3001}",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3001}",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:node": "node --no-warnings --test \"lib/**/*.node-test.mjs\"",
    "generate:api": "openapi-typescript lib/api/openapi.snapshot.json -o lib/api/generated/v2.d.ts",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "e2e": "playwright test",
    "e2e:local-auth": "playwright test -c playwright.local-auth.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.6.0",
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/browser": "11.11.0",
    "@serwist/next": "9.5.13",
    "@tanstack/query-sync-storage-persister": "5.106.1",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-persist-client": "5.106.1",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "tailwind-merge": "3.7.0",
    "ulid": "3.0.2",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fullcalendar/core": "7.1.4",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@lhci/cli": "0.16.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "1.65.0",
    "@size-limit/preset-app": "14.3.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "10.6.2",
    "eslint": "9.13.0",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "recharts": "3.10.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "size-limit": [
    {
      "name": "(coach)/today",
      "path": ".next/static/chunks/app/**/coach/today/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(parent)/onboarding",
      "path": ".next/static/chunks/app/**/parent/onboarding/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(admin)/landing",
      "path": ".next/static/chunks/app/**/admin/page-*.js",
      "limit": "360 KB"
    }
  ]
}
