{
  "name": "academy-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:api": "openapi-typescript http://localhost:8001/openapi.json -o lib/api/generated/v2.d.ts",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "e2e": "playwright test",
    "e2e:local-auth": "playwright test -c playwright.local-auth.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@serwist/next": "9.5.12",
    "@tanstack/query-sync-storage-persister": "5.102.2",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-query-persist-client": "5.102.2",
    "clsx": "2.1.1",
    "firebase": "12.18.0",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.12",
    "tailwind-merge": "3.6.0",
    "ulid": "3.0.2",
    "web-vitals": "6.2.0"
  },
  "devDependencies": {
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/react": "7.0.2",
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.62.1",
    "@size-limit/preset-app": "13.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.26",
    "recharts": "3.10.1",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "size-limit": [
    {
      "name": "(coach)/today",
      "path": ".next/static/chunks/app/**/coach/today/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(parent)/onboarding",
      "path": ".next/static/chunks/app/**/parent/onboarding/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(admin)/landing",
      "path": ".next/static/chunks/app/**/admin/page-*.js",
      "limit": "360 KB"
    }
  ]
}
