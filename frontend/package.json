{
  "name": "academy-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript http://localhost:8001/openapi.json -o lib/api/generated/v2.d.ts",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "e2e": "playwright test",
    "e2e:local-auth": "playwright test -c playwright.local-auth.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@serwist/next": "9.5.11",
    "@tanstack/query-sync-storage-persister": "5.100.11",
    "@tanstack/react-query": "5.59.16",
    "@tanstack/react-query-persist-client": "5.59.16",
    "clsx": "2.1.1",
    "firebase": "11.0.2",
    "lucide-react": "1.16.0",
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "serwist": "9.5.11",
    "tailwind-merge": "3.6.0",
    "ulid": "2.3.0",
    "web-vitals": "4.2.4"
  },
  "devDependencies": {
    "@fullcalendar/daygrid": "6.1.15",
    "@fullcalendar/react": "6.1.15",
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "1.60.0",
    "@size-limit/preset-app": "11.1.6",
    "@types/node": "22.8.6",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "eslint-config-next": "15.5.18",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.47",
    "recharts": "2.13.3",
    "size-limit": "11.1.6",
    "tailwindcss": "3.4.14",
    "typescript": "5.9.3",
    "wrangler": "^4.92.0"
  },
  "size-limit": [
    {
      "name": "(coach)/today",
      "path": ".next/static/chunks/app/**/coach/today/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(parent)/onboarding",
      "path": ".next/static/chunks/app/**/parent/onboarding/page-*.js",
      "limit": "360 KB"
    },
    {
      "name": "(admin)/landing",
      "path": ".next/static/chunks/app/**/admin/page-*.js",
      "limit": "360 KB"
    }
  ],
  "pnpm": {
    "overrides": {
      "tmp": "0.2.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
