{
  "name": "academy-manager-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "cap sync",
    "sync:release": "MOBILE_RELEASE=1 MOBILE_SERVER_URL=${MOBILE_SERVER_URL:-https://blno-academy.courtmastr.com} cap sync",
    "ios": "cap run ios",
    "android": "cap run android",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#0a0f1c' --iconBackgroundColorDark '#0a0f1c' --splashBackgroundColor '#0a0f1c' --splashBackgroundColorDark '#0a0f1c'",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "firebase": "12.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1",
    "typescript": "5.9.3"
  }
}
