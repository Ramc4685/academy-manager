# Copy this file to .env and fill in your own Stripe test keys.
# Never commit real keys, even test-mode keys.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Requested Stripe API version for this sample.
STRIPE_API_VERSION=2026-06-24.dahlia

# Public root URL for this local demo. For production, use your deployed HTTPS URL.
ROOT_URL=http://localhost:4242

# Sample platform fee, in the smallest currency unit. 123 = $1.23 for USD.
APPLICATION_FEE_AMOUNT=123

# Port used by the local demo server.
PORT=4242
