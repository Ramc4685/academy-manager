APP_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=academy_manager_local

# Auth
# Generate a local value with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-local-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
COOKIE_SECURE=false
SEED_DEMO_ACCOUNTS=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=academy-courtmastr
# Firebase Storage bucket for logo upload (unset => upload answers 503, pasting a link still works)
# V2_MEDIA_STORAGE_BUCKET=academy-courtmastr.firebasestorage.app

# SaaS tenancy (only relevant when V2_SAAS_MODE=true).
# V2_PLATFORM_BASE_DOMAIN pins subdomain tenant resolution to
# <slug>.<base-domain> so arbitrary first-label Hosts cannot resolve a
# tenant (issue #519). Set it to the platform's app domain in deployments.
#V2_PLATFORM_BASE_DOMAIN=localhost
# The internal tenant header is only honoured when the request ALSO presents
# V2_PROXY_SHARED_SECRET via the x-cm-proxy-auth header. Configure both
# together or the header source stays disabled (fail closed).
#V2_ALLOWED_INTERNAL_TENANT_HEADER=x-internal-tenant-id
#V2_PROXY_SHARED_SECRET=

# Browser/API origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe test mode. Leave blank until testing payments.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Resend email. Leave blank until testing email delivery.
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# WhatsApp class-group posts via OpenWA (docs/design/whatsapp-channel/).
# Off by default. In dev, real posts only reach chat ids in V2_WHATSAPP_SANDBOX_CHATS;
# everything else is stubbed. From the backend container, OpenWA on the host is
# http://host.docker.internal:2785. Use an operator key scoped to the session.
# Never copy APP_ENV=staging/production into a local .env: it promotes the stack to
# staging/prod and the sandbox allowlist stops applying (real class groups get posts).
# Single-academy mode only (one linked number serves every academy otherwise).
V2_WHATSAPP_DELIVERY_ENABLED=false
V2_OPENWA_BASE_URL=
V2_OPENWA_API_KEY=
V2_OPENWA_SESSION_ID=
V2_WHATSAPP_SANDBOX_CHATS=
