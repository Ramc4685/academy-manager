APP_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=academy_manager_local

# Auth
# Generate a local value with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-local-secret
ADMIN_EMAIL=admin@badminton.app
ADMIN_PASSWORD=Admin@12345
COOKIE_SECURE=false

# Browser/API origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe test mode. Leave blank until testing payments.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend email. Leave blank until testing email delivery.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Optional future WhatsApp integration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
